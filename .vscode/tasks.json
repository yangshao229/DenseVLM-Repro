{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DenseVLM · 检查 GPU 算子",
      "type": "process",
      "command": "/home/lenovo/.venvs/densevlm/bin/python",
      "args": ["${workspaceFolder}/scripts/linux/check_gpu_linux.py"],
      "problemMatcher": []
    },
    {
      "label": "DenseVLM · 检查官方入口",
      "type": "process",
      "command": "/home/lenovo/.venvs/densevlm/bin/python",
      "args": ["-m", "training.main", "--help"],
      "options": {"cwd": "${workspaceFolder}/DenseVLM"},
      "problemMatcher": []
    },
    {
      "label": "DenseVLM · COCO 4 图冒烟",
      "type": "process",
      "command": "/home/lenovo/.venvs/densevlm/bin/python",
      "args": [
        "-X", "utf8", "-u", "${workspaceFolder}/scripts/linux/run_densevlm_linux.py", "--legacy-mask-resize",
        "--model", "EVA02-CLIP-B-16", "--pretrained", "eva",
        "--test-type", "coco_panoptic", "--train-data=",
        "--val-data", "data/coco_smoke/panoptic_val2017.json",
        "--val-image-root", "data/coco_smoke/val2017",
        "--val-segm-root", "data/coco_smoke/panoptic_val2017",
        "--embed-path", "metadata/coco_panoptic_clip_hand_craft_EVACLIP_ViTB16.npy",
        "--cache-dir", "checkpoints/densevlm_coco_6_save6_512_eva_vib16_12layers.pt",
        "--name", "${input:smokeName}", "--batch-size", "1", "--workers", "0",
        "--extract-type", "v2", "--downsample-factor", "16", "--det-image-size", "512"
      ],
      "options": {"cwd": "${workspaceFolder}/DenseVLM"},
      "problemMatcher": []
    },
    {
      "label": "DenseVLM · 完整 COCO val2017 评估",
      "type": "process",
      "command": "/home/lenovo/.venvs/densevlm/bin/python",
      "args": [
        "-X", "utf8", "-u", "${workspaceFolder}/scripts/linux/run_densevlm_linux.py", "--legacy-mask-resize",
        "--model", "EVA02-CLIP-B-16", "--pretrained", "eva",
        "--test-type", "coco_panoptic", "--train-data=",
        "--val-data", "data/coco/annotations/panoptic_val2017.json",
        "--val-image-root", "data/coco/val2017",
        "--val-segm-root", "data/coco/annotations/panoptic_val2017",
        "--embed-path", "metadata/coco_panoptic_clip_hand_craft_EVACLIP_ViTB16.npy",
        "--cache-dir", "checkpoints/densevlm_coco_6_save6_512_eva_vib16_12layers.pt",
        "--name", "${input:evalName}", "--batch-size", "1", "--workers", "0",
        "--extract-type", "v2", "--downsample-factor", "16", "--det-image-size", "512"
      ],
      "options": {"cwd": "${workspaceFolder}/DenseVLM"},
      "problemMatcher": []
    },
    {
      "label": "DenseVLM · 完整 COCO val2017 评估（SDPA A/B）",
      "type": "process",
      "command": "/home/lenovo/.venvs/densevlm/bin/python",
      "args": [
        "-X", "utf8", "-u", "${workspaceFolder}/scripts/linux/run_densevlm_linux.py", "--legacy-mask-resize", "--attn-sdpa",
        "--model", "EVA02-CLIP-B-16", "--pretrained", "eva",
        "--test-type", "coco_panoptic", "--train-data=",
        "--val-data", "data/coco/annotations/panoptic_val2017.json",
        "--val-image-root", "data/coco/val2017",
        "--val-segm-root", "data/coco/annotations/panoptic_val2017",
        "--embed-path", "metadata/coco_panoptic_clip_hand_craft_EVACLIP_ViTB16.npy",
        "--cache-dir", "checkpoints/densevlm_coco_6_save6_512_eva_vib16_12layers.pt",
        "--name", "${input:sdpaEvalName}", "--batch-size", "1", "--workers", "0",
        "--extract-type", "v2", "--downsample-factor", "16", "--det-image-size", "512"
      ],
      "options": {"cwd": "${workspaceFolder}/DenseVLM"},
      "problemMatcher": []
    },
    {
      "label": "DenseVLM · 完整 ADE20K 验证集评估",
      "type": "process",
      "command": "/home/lenovo/.venvs/densevlm/bin/python",
      "args": [
        "-X", "utf8", "-u", "${workspaceFolder}/scripts/linux/run_densevlm_linux.py", "--legacy-mask-resize",
        "--model", "EVA02-CLIP-B-16", "--pretrained", "eva",
        "--test-type", "ade_panoptic", "--train-data=",
        "--val-data", "data/ADEChallengeData2016/ade20k_panoptic_val.json",
        "--val-image-root", "data/ADEChallengeData2016/images/validation",
        "--val-segm-root", "data/ADEChallengeData2016/ade20k_panoptic_val",
        "--embed-path", "metadata/ade_panoptic_clip_hand_craft_EVACLIP_ViTB16.npy",
        "--cache-dir", "checkpoints/densevlm_coco_6_save6_512_eva_vib16_12layers.pt",
        "--name", "${input:adeEvalName}", "--batch-size", "1", "--workers", "0",
        "--extract-type", "v2", "--downsample-factor", "16", "--det-image-size", "512"
      ],
      "options": {"cwd": "${workspaceFolder}/DenseVLM"},
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "smokeName",
      "type": "promptString",
      "description": "输入一个尚未使用的冒烟实验名",
      "default": "densevlm_coco_smoke_linux_vscode"
    },
    {
      "id": "evalName",
      "type": "promptString",
      "description": "输入一个尚未使用的实验名",
      "default": "densevlm_coco_val2017_linux_vscode"
    },
    {
      "id": "sdpaEvalName",
      "type": "promptString",
      "description": "输入一个尚未使用的 SDPA 对照实验名",
      "default": "densevlm_coco_val2017_linux_sdpa"
    },
    {
      "id": "adeEvalName",
      "type": "promptString",
      "description": "输入一个尚未使用的 ADE20K 实验名",
      "default": "densevlm_ade20k_val_linux_vscode"
    }
  ]
}
