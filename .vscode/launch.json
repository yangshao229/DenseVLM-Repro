{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DenseVLM · COCO 小样本（单卡，Linux 原生 xFormers）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/linux/run_densevlm_linux.py",
      "python": "/home/lenovo/.venvs/densevlm/bin/python",
      "cwd": "${workspaceFolder}/DenseVLM",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--legacy-mask-resize",
        "--model", "EVA02-CLIP-B-16",
        "--pretrained", "eva",
        "--test-type", "coco_panoptic",
        "--train-data=",
        "--val-data", "data/coco_smoke/panoptic_val2017.json",
        "--val-image-root", "data/coco_smoke/val2017",
        "--val-segm-root", "data/coco_smoke/panoptic_val2017",
        "--embed-path", "metadata/coco_panoptic_clip_hand_craft_EVACLIP_ViTB16.npy",
        "--cache-dir", "checkpoints/densevlm_coco_6_save6_512_eva_vib16_12layers.pt",
        "--name", "densevlm_coco_smoke_vscode_linux",
        "--batch-size", "1",
        "--workers", "0",
        "--extract-type", "v2",
        "--downsample-factor", "16",
        "--det-image-size", "512"
      ]
    }
  ]
}
